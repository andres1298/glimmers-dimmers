# Proyecto de Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Genera un valor aleatorio largo, por ejemplo con: openssl rand -base64 32
SESSION_SECRET=

# Clave compartida para entrar al panel de administracion en /admin
ADMIN_PASSWORD=

# Zona horaria usada para definir "el dia de hoy" y las rachas
APP_TIMEZONE=America/Costa_Rica
